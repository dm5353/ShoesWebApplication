@model ShoesWebApplication.Models.Order

@{
    ViewData["Title"] = "Delete";
}

<h2>Удаление заказа</h2>

<h4>Вы уверены, что хотите удалить заказ?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Дата заказа</dt>
    <dd class="col-sm-9">@Model.OrderDate</dd>

    <dt class="col-sm-3">Дата доставки</dt>
    <dd class="col-sm-9">@Model.SupplyDate</dd>

    <dt class="col-sm-3">Код</dt>
    <dd class="col-sm-9">@Model.Code</dd>

    <dt class="col-sm-3">Пользователь</dt>
    <dd class="col-sm-9">@Model.User?.FullName</dd>

    <dt class="col-sm-3">Статус</dt>
    <dd class="col-sm-9">@Model.OrderStatus?.Status</dd>

    <dt class="col-sm-3">Адрес</dt>
    <dd class="col-sm-9">
        @Model.Address?.Index,
        @Model.Address?.City,
        @Model.Address?.Street,
        @Model.Address?.HouseNumber
    </dd>

</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Удалить
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Отмена
    </a>
</form>