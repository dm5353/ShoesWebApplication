@model ShoesWebApplication.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<h2>Создание заказа</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Дата заказа</label>
        <input asp-for="OrderDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Дата доставки</label>
        <input asp-for="SupplyDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Пользователь</label>
        <select asp-for="UserId" class="form-control"
                asp-items="@(new SelectList(ViewData["Users"] as IEnumerable<User>, "Id", "FullName"))">
        </select>
    </div>

    <div class="form-group">
        <label>Адрес</label>
        <select asp-for="AddressId" class="form-control"
                asp-items="@(new SelectList(ViewData["Addresses"] as IEnumerable<Address>, "Id", "Street"))">
        </select>
    </div>

    <div class="form-group">
        <label>Статус</label>
        <select asp-for="OrderStatusId" class="form-control"
                asp-items="@(new SelectList(ViewData["Statuses"] as IEnumerable<OrderStatus>, "Id", "Status"))">
        </select>
    </div>

    <div class="form-group">
        <label>Код заказа</label>
        <input asp-for="Code" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>

            <a asp-action="Index" class="btn btn-secondary">
                Назад
            </a>
</form>
