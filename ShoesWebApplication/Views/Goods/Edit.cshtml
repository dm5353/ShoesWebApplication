@model ShoesWebApplication.Models.Good

@{
    ViewData["Title"] = "Редактирование товара";
}

<h2 class="mb-4">Редактирование товара</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">ID (артикул)</label>
                <input asp-for="Id" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Название</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">Цена</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Discount" class="form-label">Скидка (%)</label>
                    <input asp-for="Discount" class="form-control" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

            </div>

            <div class="mb-3">
                <label asp-for="Count" class="form-label">Количество</label>
                <input asp-for="Count" class="form-control" />
                <span asp-validation-for="Count" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Текущее изображение</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="/images/@Model.Image" style="max-height:120px;" />
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Заменить изображение</label>
                <input type="file"
                       name="imageFile"
                       class="form-control"
                       accept=".jpg,.jpeg,.png" />
            </div>

            <div class="mb-3">
                <label asp-for="GoodCategoryId" class="form-label">Категория</label>
                <select asp-for="GoodCategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-select">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="ManufacturerId" class="form-label">Производитель</label>
                <select asp-for="ManufacturerId"
                        asp-items="ViewBag.Manufacturers"
                        class="form-select">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="SupplierId" class="form-label">Поставщик</label>
                <select asp-for="SupplierId"
                        asp-items="ViewBag.Suppliers"
                        class="form-select">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="GoodMeasurementId" class="form-label">Ед. измерения</label>
                <select asp-for="GoodMeasurementId"
                        asp-items="ViewBag.Measurements"
                        class="form-select">
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Сохранить
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Назад
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}