@model ShoesWebApplication.Models.Good

@{
    ViewData["Title"] = "Удаление товара";
}

<h2 class="mb-3">Удаление товара</h2>

<h5 class="text-danger">Вы уверены, что хотите удалить этот товар?</h5>

<div class="border p-3 mt-3">

    <div class="mb-2">
        <b>Название:</b> @Model.Name
    </div>

    <div class="mb-2">
        <b>Цена:</b> @Model.Price
    </div>

    <div class="mb-2">
        <b>Скидка:</b> @Model.Discount%
    </div>

    <div class="mb-2">
        <b>Количество:</b> @Model.Count
    </div>

    <div class="mb-2">
        <b>Описание:</b> @Model.Description
    </div>

    <div class="mb-2">
        <b>Категория:</b> @Model.GoodCategory.Category
    </div>

    <div class="mb-2">
        <b>Поставщик:</b> @Model.Supplier.Name
    </div>

    <div class="mb-2">
        <b>Производитель:</b> @Model.Manufacturer.Name
    </div>

    <div class="mb-2">
        <b>Ед. измерения:</b> @Model.GoodMeasurement.Name
    </div>

    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <div class="mt-3">
            <img src="/images/@Model.Image" style="max-height:150px;" />
        </div>
    }

</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Удалить
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Отмена
    </a>
</form>

<div asp-validation-summary="All" class="text-danger"></div>